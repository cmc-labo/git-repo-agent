# --- Gemini (どちらか) ---
# Vertex AI 経由 (推奨 / Cloud Run ではサービスアカウントで認証)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=global
# Gemini API キー
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 認証情報なしでサンプル出力で動かす場合
# DEMO_MODE=true

# --- DB (Turso). 未設定ならローカル SQLite ---
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=

# --- GitHub (public リポジトリの rate limit 緩和用, 任意) ---
GITHUB_TOKEN=

# --- App ---
APP_SECRET=change-me            # private リポジトリ用トークンの暗号化キー
CRON_TOKEN=change-me            # /api/cron/poll の認証
PUBLIC_BASE_URL=http://localhost:8000   # Webhook URL の表示に使う
CORS_ORIGINS=*

# --- Demo repository (registered and analyzed once on first startup; empty to disable) ---
DEMO_REPO=antirez/kilo
DEMO_REPO_LANGUAGE=en

# --- Cloudflare Turnstile (bot protection for repository registration; empty = disabled) ---
TURNSTILE_SECRET_KEY=
